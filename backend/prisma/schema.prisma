generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppUser {
  supabaseUserId      String               @id
  email               String?
  role                Role                 @default(USER)
  subscription        Subscription?
  industries          NewsCategory[]       @default([])
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  conversations       ChatConversation[]
  personality         PersonalityResult[]
  profile             PersonalProfile?
  stripeCustomerId    String?              @unique
  stripeSubscriptions StripeSubscription[]
}

model ChatConversation {
  id        String        @id @default(uuid())
  ownerId   String
  service   Service
  title     String?
  createdAt DateTime      @default(now())
  owner     AppUser       @relation(fields: [ownerId], references: [supabaseUserId])
  messages  ChatMessage[]
}

model ChatMessage {
  id             String           @id @default(uuid())
  conversationId String
  sender         Sender
  kind           MessageKind
  content        String
  attachmentUrl  String?
  voiceUrl       String?
  createdAt      DateTime         @default(now())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id])
}

model PersonalityResult {
  id        String   @id @default(uuid())
  ownerId   String
  testType  TestType
  result    String?
  fileKey   String?
  status    Status   @default(RECEIVED)
  createdAt DateTime @default(now())
  owner     AppUser  @relation(fields: [ownerId], references: [supabaseUserId])
}

model NewsItem {
  id          String       @id @default(uuid())
  category    NewsCategory
  title       String
  description String
  link        String
  pubDate     DateTime?
  source      String
  sourceIcon  String?
  country     String?
  industries  Industry[]   @default([])
  newsDate    DateTime     @default(now())
  createdAt   DateTime     @default(now())

  @@index([newsDate])
  @@index([category])
  @@index([industries])
}

enum Role {
  USER
  ADMIN
}

enum Subscription {
  VITAAI
  EXECUWELL
  INTEGRATED
}

enum Service {
  VITAAI
  EXECUWELL
}

enum Sender {
  USER
  ASSISTANT
}

enum MessageKind {
  TEXT
  VOICE
  IMAGE
}

enum TestType {
  SIXTEEN_PERSONALITIES
  STRENGTHSFINDER
  ENNEAGRAM
  DISC
  CLIFTONSTRENGTHS
}

enum Status {
  PENDING
  RECEIVED
  VERIFIED
  REJECTED
}

enum NewsCategory {
  business
  crime
  education
  entertainment
  environment
  food
  health
  lifestyle
  politics
  science
  sports
  technology
  top
  tourism
  world
  other
}

enum Industry {
  MANUFACTURING
  IT_TECHNOLOGY
  HEALTHCARE_WELFARE
  RETAIL_SERVICE
  FINANCE_INSURANCE
  REAL_ESTATE_BUILDING
  EDUCATION_HUMAN_RESOURCES
  GENERAL
}

model PersonalProfile {
  id        String            @id @default(uuid())
  ownerId   String            @unique
  fullName  String?
  company   String?
  position  String?
  birthDate DateTime?
  execuWell ExecuWellProfile?
  vitaAI    VitaAiProfile?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  owner     AppUser           @relation(fields: [ownerId], references: [supabaseUserId])
}

model ExecuWellProfile {
  id                 String          @id @default(uuid())
  profileId          String          @unique
  mbti               String?
  enneagram          Int?
  disc               String?
  industries         String[]
  currentRoles       String[]
  licenses           String[]
  businessGoal       String?
  values             String[]
  interests          String[]
  tone               String?
  motivationStyle    String?
  analysisDepth      String?
  businessChallenges String[]
  healthScore        Int?
  selfScore          Int?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  profile            PersonalProfile @relation(fields: [profileId], references: [id])
}

model VitaAiProfile {
  id             String          @id @default(uuid())
  profileId      String          @unique
  testId         String?
  testDate       DateTime?
  geneticSummary Json?
  sportsProfile  Json?
  rawPayload     Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  profile        PersonalProfile @relation(fields: [profileId], references: [id])
}

model StripeSubscription {
  id                   String             @id @default(uuid())
  userId               String
  stripeSubscriptionId String             @unique
  stripeCustomerId     String
  stripePriceId        String
  subscriptionType     Subscription
  status               SubscriptionStatus @default(ACTIVE)

  // Stripe recurring billing fields (all optional - Stripe webhooks send partial objects)
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  billingCycleAnchor     DateTime?
  trialStart             DateTime?
  trialEnd               DateTime?
  cancelAt               DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  canceledAt             DateTime?

  // Stripe invoice and payment fields
  latestInvoiceId        String?
  defaultPaymentMethodId String?

  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user                 AppUser            @relation(fields: [userId], references: [supabaseUserId], onDelete: Cascade)

  @@index([userId])
  @@index([stripeSubscriptionId])
  @@index([stripeCustomerId])
  @@index([status])
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  UNPAID
  INCOMPLETE
  INCOMPLETE_EXPIRED
  TRIALING
  PAUSED
}
