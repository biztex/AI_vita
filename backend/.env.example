PORT=5000
NODE_ENV=development

# ─── PostgreSQL ───
DATABASE_URL="postgresql://postgres:password@localhost:5432/vita_AI?schema=public"

# ─── Supabase Auth ───
SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_ISSUER=https://YOUR_PROJECT.supabase.co/auth/v1
SUPABASE_AUDIENCE=authenticated

# ─── OpenAI ───
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxx

# ─── News API ───
NEWSDATA_API_KEY=pub_xxxxxxxxxxxxxxxx
# Comma-separated keywords for interest-based news (optional)
NEWS_INTEREST_KEYWORDS=

# ─── Stripe ───
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
STRIPE_PRICE_VITAAI=price_xxxxxxxxxxxx
STRIPE_PRICE_EXECUWELL=price_xxxxxxxxxxxx
STRIPE_PRICE_INTEGRATED=price_xxxxxxxxxxxx

# ─── Frontend URL ───
FRONTEND_URL=https://execuwell.jp

# ─── LINE Messaging API ───
# Get these from LINE Developers Console → your Messaging API channel
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token

# Webhook URL (set this in LINE Developers Console → Messaging API → Webhook settings)
# Format: https://<your-domain>/api/line/webhook
# Example: https://execuwell.jp/api/line/webhook
# NOTE: This is NOT an env var — it's a reminder of the URL to register in LINE Console.
LINE_WEBHOOK_URL=https://execuwell.jp/api/line/webhook

# ─── LINE Login (OAuth) ───
# Create a separate LINE Login channel in LINE Developers Console
# Set Callback URL to: https://<your-domain>/line-callback (frontend route)
LINE_LOGIN_CHANNEL_ID=your_line_login_channel_id
LINE_LOGIN_CHANNEL_SECRET=your_line_login_channel_secret
LINE_LOGIN_CALLBACK_URL=https://execuwell.jp/line-callback

# ─── LIFF (LINE mini app). Endpoint examples: /liff/detail (ExecuWell), /liff/log (VitaAI 5秒記録) ───
# If unset, ExecuWell LINE replies are sent as full text (no button). VitaAI朝プッシュの記録URLにも使用。
LIFF_ID=
# Optional: separate LIFF app for multi-page routes (/liff/*). Rich menu & 朝プッシュはこちらを優先。
LIFF_ID_PAGES=

# ─── SMTP (optional — if absent, email digests are logged instead of sent) ───
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=user@example.com
# SMTP_PASS=password
# SMTP_FROM=noreply@example.com
# SMTP_FROM_NAME=Execuwell ニュース配信
